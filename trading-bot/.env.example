# Copia a .env y rellena. .env esta en .gitignore.

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8777

# Carpeta que el bot llena con archivos .jsonl de telemetria.
# Debe coincidir con el parametro "Carpeta de telemetria" del cBot.
RUNS_DIR=C:/Users/eical/trading-bot/data/runs

# Base de datos del dashboard (SQLite).
DB_PATH=C:/Users/eical/trading-bot/data/dashboard.sqlite

# --- Alarmas ---
# Canales activos, separados por coma: console, twilio_sms, twilio_whatsapp
ALARM_CHANNELS=console

# En backtest, ¿enviar alarmas por los canales externos? (normalmente no)
ALARM_NOTIFY_IN_BACKTEST=false

# --- Twilio (SMS / WhatsApp) ---
# SMS cuesta por mensaje. WhatsApp tiene sandbox gratis para pruebas:
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # p.ej. +1XXXXXXXXXX  (SMS)  |  whatsapp:+14155238886 (sandbox)
TWILIO_TO=             # tu numero, p.ej. +52XXXXXXXXXX  |  whatsapp:+52XXXXXXXXXX
