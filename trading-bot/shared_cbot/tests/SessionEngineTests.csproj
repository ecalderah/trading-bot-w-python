<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SessionEngineTests</AssemblyName>
    <RootNamespace>SessionEngineTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- El SessionEngine no depende de cAlgo.API: es .NET puro y por eso se
         puede compilar y probar aqui, fuera de cTrader. -->
    <Compile Include="../SessionEngine.cs" />
    <Compile Include="../Signals.cs" />
    <Compile Include="../RiskSizer.cs" />
    <Compile Include="../CostTracker.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="SignalsTests.cs" />
    <Compile Include="RiskSizerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="vectores/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
